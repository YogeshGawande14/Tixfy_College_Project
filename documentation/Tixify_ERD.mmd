erDiagram
    CITIES ||--o{ THEATERS : contains
    THEATERS ||--o{ SCREENS : has
    SCREENS ||--o{ SEATS : contains
    MOVIES ||--o{ SHOWS : scheduled_for
    SCREENS ||--o{ SHOWS : hosts
    USERS ||--o{ BOOKINGS : makes
    SHOWS ||--o{ BOOKINGS : booked_for
    BOOKINGS ||--o{ BOOKING_SEATS : includes
    SEATS ||--o{ BOOKING_SEATS : assigned_to

    CITIES {
        int city_id PK
        varchar name
        varchar state
    }
    USERS {
        int user_id PK
        varchar name
        varchar email
        varchar password
        varchar phone
        datetime created_at
    }
    MOVIES {
        int movie_id PK
        varchar title
        varchar description
        varchar genre
        varchar language
        int duration_minutes
        decimal rating
        date release_date
        varchar poster_url
    }
    THEATERS {
        int theater_id PK
        varchar name
        varchar address
        int city_id FK
    }
    SCREENS {
        int screen_id PK
        varchar name
        int total_seats
        int theater_id FK
    }
    SEATS {
        int seat_id PK
        varchar seat_number
        varchar seat_row
        int seat_col
        varchar seat_type
        int screen_id FK
    }
    SHOWS {
        int show_id PK
        int movie_id FK
        int screen_id FK
        date show_date
        time start_time
        time end_time
        decimal ticket_price
    }
    BOOKINGS {
        int booking_id PK
        int user_id FK
        int show_id FK
        decimal total_price
        varchar status
        datetime booked_at
    }
    BOOKING_SEATS {
        int booking_id FK
        int seat_id FK
    }
